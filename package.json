    "@types/node": "^22.20.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
