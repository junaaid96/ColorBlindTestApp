{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Least-privilege permissions for Android and iOS.",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "os:allow-platform",
    "os:allow-arch",
    "opener:allow-open-url",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "deep-link:default",
    "log:default",
    "haptics:default"
  ]
}
