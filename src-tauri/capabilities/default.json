{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the desktop app window.",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "os:allow-platform",
    "os:allow-arch",
    "opener:allow-open-url",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "deep-link:default",
    "log:default",
    "updater:default",
    "process:allow-restart",
    "window-state:default"
  ]
}
