{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Vision Lab",
  "version": "../package.json",
  "identifier": "io.github.junaaid96.colorvisionlab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Color Vision Lab",
        "width": 1180,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "media-src": "'self' blob: mediastream:",
        "connect-src": "ipc: http://ipc.localhost 'self' blob:",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Colour vision screening and tools",
    "longDescription": "Private, offline colour vision screening (plates, hue arrangement, contrast), a live colour lens and a photo simulator.",
    "copyright": "Copyright (c) 2026 Md. Junaidul Islam",
    "license": "MIT",
    "homepage": "https://color-vision-lab-codejborg.vercel.app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "iOS": { "minimumSystemVersion": "14.0" },
    "android": { "minSdkVersion": 24 }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["colorvisionlab"] },
      "mobile": [{ "scheme": ["colorvisionlab"], "appLink": false }]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDQjU5NjcyQzg0QjJDQzEKUldUQkxFdkljcGExWFBDY1FZdHVPOGFPMmpNekRYcHRITXY5L2JJRWROMFY1MlZ3NlY4R0huZTAK",
      "endpoints": ["https://github.com/junaaid96/color-vision-lab/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
