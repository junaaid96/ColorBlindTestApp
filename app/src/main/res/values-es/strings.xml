    <string name="onb_welcome_title">Mira el color a tu manera</string>
    <string name="onb_welcome_body">Evalúa tu visión del color, descubre cómo ven otras personas e identifica colores con la cámara. Todo funciona sin conexión en tu dispositivo.</string>
    <string name="onb_disclaimer_title">Una evaluación, no un diagnóstico</string>
    <string name="disclaimer_full">Color Vision Lab es una herramienta educativa de evaluación. Las pantallas varían en color y brillo, por lo que los resultados son aproximados y no constituyen un diagnóstico médico. Si te preocupa tu visión, consulta a un profesional de la salud visual para una prueba clínica como Ishihara, Farnsworth D-15 o anomaloscopio.</string>
    <string name="disclaimer_short">Solo evaluación, no es un diagnóstico médico.</string>
    <string name="onb_calibrate_title">Para un resultado más preciso</string>
    <string name="onb_calibrate_body">Unos segundos de preparación marcan la diferencia:</string>
    <string name="tip_brightness">Sube el brillo de la pantalla al máximo</string>
    <string name="tip_night">Desactiva luz nocturna y filtros de luz azul</string>
    <string name="tip_light">Usa luz natural uniforme y evita reflejos</string>
    <string name="tip_distance">Sostén el teléfono a unos 40 cm; usa tus gafas habituales</string>
    <string name="home_hero_title">Tu sesión de hoy</string>
    <string name="home_hero_body">Una evaluación rápida de dos minutos o una ronda de práctica mantiene tu racha.</string>
