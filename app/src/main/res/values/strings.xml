    <string name="onb_welcome_title">See color your way</string>
    <string name="onb_welcome_body">Screen your color vision, explore how others see, and identify colors with your camera. Everything runs offline on your device.</string>
    <string name="onb_disclaimer_title">A screening, not a diagnosis</string>
    <string name="disclaimer_full">Color Vision Lab is an educational screening tool. Screens vary in color and brightness, so results are approximate and are not a medical diagnosis. If you have concerns about your vision, see an eye-care professional for a clinical test such as the Ishihara, Farnsworth D-15 or anomaloscope.</string>
    <string name="disclaimer_short">Screening only, not a medical diagnosis.</string>
    <string name="onb_calibrate_title">Get the most accurate result</string>
    <string name="onb_calibrate_body">A few seconds of setup makes a big difference:</string>
    <string name="tip_brightness">Turn screen brightness to maximum</string>
    <string name="tip_night">Turn off night light, eye comfort and blue-light filters</string>
    <string name="tip_light">Use even, natural daylight and avoid glare</string>
    <string name="tip_distance">Hold the phone about 40 cm from your eyes; wear your usual glasses</string>
